# Board credentials. Copy this file to .env (never committed) and fill it in.
# Create the token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_SITE=your-company.atlassian.net
JIRA_EMAIL=you@your-company.com
JIRA_TOKEN=

# Optional: Sentry token for the Sentry tab. Without it, the board reads the one in <root>/.mcp.json.
SENTRY_TOKEN=

# Optional: long-lived Claude token for the hosted sessions, from claude setup-token, so they do not depend on /login.
# CLAUDE_TOKEN_EXPIRES (YYYY-MM-DD) makes the board warn a month before it runs out.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_TOKEN_EXPIRES=
